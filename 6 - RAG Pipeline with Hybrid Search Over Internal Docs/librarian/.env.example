# Copy to .env and fill in. Empty defaults run fully local ($0): Ollama embeddings,
# file-based Chroma, file-based chunk store. Keys are only needed from Phase 3 on.

# --- embeddings (one model per index; changing it means re-indexing into a new collection) ---
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
OLLAMA_BASE_URL=http://localhost:11434/v1
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# --- chat providers (Phase 3: generator / judge chains) ---
MISTRAL_API_KEY=
GROQ_API_KEY=

# --- optional paid provider (off by default; chain entries dropped while false) ---
ENABLE_PAID_PROVIDERS=false
EXPLABS_API_KEY=
EXPLABS_BASE_URL=https://api.experientiallabs.ai/v1

# --- stores (CHROMA_HOST empty = local persistent client under CHROMA_PATH) ---
CHROMA_HOST=
CHROMA_PORT=8001
CHROMA_PATH=./data/chroma
STORE_PATH=./data/chunks.db
CORPUS_DIR=./data/corpus

# --- retrieval knobs (defaults tuned in Phase 4 against the golden set) ---
DEDUP_THRESHOLD=0.95
WEIGHT_DENSE=0.7
WEIGHT_SPARSE=0.3
RERANKER=cross-encoder
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
CHUNK_STRATEGY=heading
CHUNK_SIZE=1200
CHUNK_OVERLAP=200
